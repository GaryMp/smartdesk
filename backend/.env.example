# Plantilla de variables de entorno del backend.
# Copia este archivo como `.env` y sustituye los valores ficticios.
# No incluyas credenciales reales en este archivo.

# Cadena de conexión a PostgreSQL. La usan Prisma (prisma7.config.ts) y PrismaService.
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@localhost:5432/smartdesk?schema=public"

# URL del webhook de producción de n8n que recibe las solicitudes de soporte.
N8N_WEBHOOK_URL="http://localhost:5678/webhook/support-request"

# Puerto HTTP del backend (opcional; por defecto 3000).
PORT=3000
