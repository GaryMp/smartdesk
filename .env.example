# Variables de Docker Compose (entorno de desarrollo local).
# Copia este archivo como `.env` en la raíz del proyecto y cambia los valores.
# No incluyas credenciales reales en este archivo de ejemplo.

# PostgreSQL
POSTGRES_USER=smartdesk
# Usa solo letras, números y guiones para no tener que codificarla en DATABASE_URL.
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=smartdesk
# Puerto publicado en 127.0.0.1. Cámbialo si ya tienes PostgreSQL en el 5432.
POSTGRES_PORT=5432

# n8n
# Puerto publicado en 127.0.0.1. Cámbialo si ya tienes n8n en el 5678.
N8N_PORT=5678
GENERIC_TIMEZONE=UTC
